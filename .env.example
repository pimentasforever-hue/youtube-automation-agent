# YouTube Automation Agent Environment Configuration
# Copy this file to .env and fill in your actual values

# AI Provider - Pick one (or use OpenRouter for access to all)
# Uncomment the line you use — placeholder values must stay commented out
# OPENAI_API_KEY=your-openai-api-key-here
# OPENROUTER_API_KEY=your-openrouter-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# MOONSHOT_API_KEY=your-kimi-api-key-here
# MIMO_API_KEY=your-mimo-api-key-here
# GLM_API_KEY=your-glm-api-key-here

# ElevenLabs TTS (optional, higher quality than OpenAI TTS)
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-voice-id-here

# Replicate (optional, for AI video generation)
# REPLICATE_API_KEY=your-replicate-api-key-here

# Free stock video for cinematic hybrid productions
# PEXELS_API_KEY=your-pexels-api-key-here
# PIXABAY_API_KEY=your-pixabay-api-key-here

# Image generation (thumbnails and scenes)
# Provider order when IMAGE_PROVIDER is empty: cloudflare > openai > gemini.
# Set it explicitly to avoid surprises , with R2 configured the Cloudflare account id is
# already present, so Cloudflare wins as soon as CLOUDFLARE_AI_API_TOKEN exists.
# The Workers AI token is NOT the R2 token: it needs the Workers AI permission.
# Check the current state with: npm run diagnose:images (add --live to generate a test image)
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_AI_API_TOKEN=your-workers-ai-token
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# CLOUDFLARE_AI_TIMEOUT_MS=120000
# OPENAI_IMAGE_MODEL=gpt-image-2

# Gemini media generation (used when GEMINI_API_KEY is your provider)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# FFmpeg (optional override; resolution order: FFMPEG_PATH > bundled ffmpeg-static > system PATH)
# FFMPEG_PATH=

# Azure Speech TTS (optional alternative)
# AZURE_SPEECH_KEY=your-azure-speech-key-here
# AZURE_SPEECH_REGION=eastus

# Application Settings
NODE_ENV=production
PORT=3456
LOG_LEVEL=info

# Channel Settings
CHANNEL_NAME=Your Channel Name
DEFAULT_AUTHOR=Your Name
TARGET_AUDIENCE=Your target audience description

# YouTube Settings
YOUTUBE_REGION=US
DEFAULT_PRIVACY_STATUS=private

# Content Settings
AUTO_SHORTEN_CONTENT=true
AUTO_ADD_BACKLINKS=true
PRESERVE_FORMATTING=true
AUTO_RESIZE_IMAGES=true
MAX_IMAGE_WIDTH=1280
MAX_IMAGE_HEIGHT=720
IMAGE_QUALITY=90

# Rate Limiting
GLOBAL_RATE_LIMIT_PER_HOUR=50
DEFAULT_DELAY_BETWEEN_POSTS=60000

# Security
# Optional. If set, mutating API routes require this value in the x-api-key header.
API_KEY=

# Analytics & Monitoring
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db

# File Upload Settings
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Error Handling
RETRY_ATTEMPTS=3
RETRY_DELAY=5000
